<?xml version="1.0" encoding="utf-8"?>
<!-- Generated from lib/desktop/policy-schema.ts by scripts/generate-desktop-policies.mjs. Do not edit. -->
<policyDefinitionResources xmlns="http://schemas.microsoft.com/GroupPolicy/2006/07/PolicyDefinitions" revision="1.0" schemaVersion="1.0">
  <displayName>Bulwark Desktop</displayName>
  <description>Settings for the Bulwark desktop app.</description>
  <resources>
    <stringTable>
      <string id="Category_Bulwark">Bulwark</string>
      <string id="Category_Desktop">Bulwark Desktop</string>
      <string id="Category_Recommended">Bulwark Desktop: defaults users can change</string>
      <string id="SUPPORTED_Bulwark_Desktop">All versions of Bulwark Desktop</string>
      <string id="Category_connection">Connection</string>
      <string id="Category_updates">Updates</string>
      <string id="Category_plugins">Plugins</string>
      <string id="Category_security">Offline mail and app lock</string>
      <string id="Category_privacy">Privacy</string>
      <string id="Category_signIn">Sign-in and certificates</string>
      <string id="Category_system">System integration and troubleshooting</string>
      <string id="InstanceUrl">Bulwark server</string>
      <string id="InstanceUrl_Explain">The address of your Bulwark server, starting with https://. When forced, the app opens on this server, the choice of server is hidden, and the window stays on it. An invalid address shows an error page that names this policy, and the app does not fall back to anything else. As a default, the app opens on this server until the user picks something else.</string>
      <string id="AllowStandalone">Allow direct connections to mail servers</string>
      <string id="AllowStandalone_Explain">When disabled, the app only opens a Bulwark server and nobody can sign in directly to a mail server. Accounts added earlier stay on the disk, but are hidden. If you force a Bulwark server and leave this not configured, direct connections are off too. Enable it to offer both.</string>
      <string id="AllowedJmapServers">Allowed mail servers</string>
      <string id="AllowedJmapServers_Explain">The mail servers people may sign in to. One per line: an address such as https://mail.example.com, or https://*.example.com for all subdomains. A server without a scheme means https. Plain http must be named with http://. When this list is set, everything else is refused, and accounts on a server taken off the list stop until it is back, keeping their data. A Bulwark server the user picks, or the one under &quot;Bulwark server&quot; as a default, must be on the list too. A forced one does not need to be.</string>
      <string id="AllowInsecureInstance">Allow a Bulwark server on plain http</string>
      <string id="AllowInsecureInstance_Explain">When enabled, the address in &quot;Bulwark server&quot; may start with http://. Passwords and mail then travel unencrypted, and the browser features that need https, such as offline mail and S/MIME, do not work. Leave this off unless the server is on a network you trust.</string>
      <string id="UpdateChannel">Update channel</string>
      <string id="UpdateChannel_Explain">Which releases the app updates to.</string>
      <string id="UpdateChannel_stable">Stable</string>
      <string id="UpdateChannel_beta">Beta</string>
      <string id="AutoUpdate">Update automatically</string>
      <string id="AutoUpdate_Explain">When disabled, the app does not look for updates or download them. Use this when SCCM, Intune or similar tools deliver updates.</string>
      <string id="PluginsMode">Which plugins may run</string>
      <string id="PluginsMode_Explain">Whether plugins can be installed and run. With the list or none, people cannot add a plugin themselves, since a package can name any id. With the list, only plugins your Bulwark server or the app&apos;s directory provides can run. A plugin that is refused keeps its data and settings: it comes back as it was if the policy allows it again.</string>
      <string id="PluginsMode_allowed">All plugins are allowed</string>
      <string id="PluginsMode_allowlist">Only plugins on the list</string>
      <string id="PluginsMode_off">No plugins</string>
      <string id="PluginAllowlist">Allowed plugins</string>
      <string id="PluginAllowlist_Explain">The ids of the plugins that may run when &quot;Which plugins may run&quot; is set to the list. One per line.</string>
      <string id="OfflineEnabled">Keep mail on the device</string>
      <string id="OfflineEnabled_Explain">Whether accounts keep an encrypted copy of mail on this device for offline use. When forced off, copies already on the device are removed.</string>
      <string id="AppLockRequired">Require an app lock</string>
      <string id="AppLockRequired_Explain">When enabled, people must set up the app lock and cannot turn it off.</string>
      <string id="AppLockTimeoutMinutes">Lock the app after</string>
      <string id="AppLockTimeoutMinutes_Explain">How many minutes without use the app stays unlocked. From 1 to 1440.</string>
      <string id="AppLockPinMinLength">Minimum length of the app lock PIN</string>
      <string id="AppLockPinMinLength_Explain">How many characters a new app lock PIN needs at least. From 5 to 64. When not configured, it is 5. A PIN set before keeps working until it is changed.</string>
      <string id="AppLockHelloAllowed">Allow unlocking the app with Windows Hello</string>
      <string id="AppLockHelloAllowed_Explain">When enabled or not configured, people can unlock the app lock with Windows Hello as well as with its PIN. When disabled, the option is hidden, and Windows Hello no longer unlocks the app where it was set up: the PIN is needed. Windows only.</string>
      <string id="TelemetryAllowed">Allow usage statistics</string>
      <string id="TelemetryAllowed_Explain">When disabled, the app sends no usage statistics and does not ask. When enabled or not configured, it still asks the user first.</string>
      <string id="CrashReportsAllowed">Allow crash reports</string>
      <string id="CrashReportsAllowed_Explain">When disabled, the app sends no crash reports and does not ask. When enabled or not configured, it still asks the user first.</string>
      <string id="QuickComposeShortcut">Global shortcut for a new message</string>
      <string id="QuickComposeShortcut_Explain">The key combination that opens a new message from anywhere, such as CommandOrControl+Alt+N. Enter off to turn the shortcut off.</string>
      <string id="AuthServerAllowlist">Servers for integrated sign-in</string>
      <string id="AuthServerAllowlist_Explain">The servers that may use the Windows sign-in (Kerberos, NTLM), separated by commas, such as *.example.com. A server taken off the list stops getting it at once. A new one needs the app to restart.</string>
      <string id="AuthNegotiateDelegateAllowlist">Servers for delegated sign-in</string>
      <string id="AuthNegotiateDelegateAllowlist_Explain">The servers the app may delegate Kerberos credentials to, separated by commas. Takes effect when the app restarts.</string>
      <string id="AutoSelectCertificateForUrls">Choose client certificates automatically</string>
      <string id="AutoSelectCertificateForUrls_Explain">One JSON rule per line, in the format Chrome uses: {&quot;pattern&quot;:&quot;https://[*.]example.com&quot;,&quot;filter&quot;:{&quot;ISSUER&quot;:{&quot;CN&quot;:&quot;Example CA&quot;}}}. The app then picks the matching certificate for that site without asking.</string>
      <string id="KeystoreEnabled">Allow the system certificate store</string>
      <string id="KeystoreEnabled_Explain">When disabled, nothing in the app can sign or decrypt with the certificates and smart cards in the operating system&apos;s store, and nobody is asked. This overrides the list of sites below. It also holds when plugins are turned off. Imported keys are not affected.</string>
      <string id="KeystoreAllowedOrigins">Sites that may use the system certificate store</string>
      <string id="KeystoreAllowedOrigins_Explain">The Bulwark servers, by https address, whose plugins may sign and decrypt with the certificates in the operating system&apos;s store, without the user being asked for each site. One per line.</string>
      <string id="BrowserSignIn">Offer sign-in through the browser</string>
      <string id="BrowserSignIn_Explain">When enabled or not configured, the login page offers &quot;Sign in with your browser&quot;, so people can use their password manager, passkeys and your single sign-on there. When disabled, the button is gone and the app refuses the flow. The form in the app stays, unless the server only allows OAuth.</string>
      <string id="WipeOfflineData">Delete mail kept on the device</string>
      <string id="WipeOfflineData_Explain">Set this to a new value, such as today&apos;s date, to delete everything the app keeps on the device for every server and account: mail, keys, and sign-ins, so people sign in again. Each value deletes once: the app remembers the ones it has acted on, so it stays safe to leave a value in place. Use a new value to delete again. That memory is in the user&apos;s own profile, so someone who edits it can skip a wipe they know is coming: this cleans up a device, it doesn&apos;t take data from the person using it.</string>
      <string id="OpenWithEnabled">Offer the app in &quot;Open with&quot; and &quot;Send to&quot;</string>
      <string id="OpenWithEnabled_Explain">When enabled or not configured, the app adds itself to the &quot;Open with&quot; list for common documents and pictures and to the &quot;Send to&quot; menu on Windows, so people can attach a file to a new message from the file manager. It never becomes the default program for those files. When disabled, the app removes these entries for the user. Mail links and .eml, .ics and .vcf files are not affected.</string>
      <string id="DeveloperToolsAvailability">Developer tools</string>
      <string id="DeveloperToolsAvailability_Explain">The same values as Chrome&apos;s policy of this name. 2: developer tools are off and the setting is locked. 0 or 1, or not configured: people can turn them on under Settings, after a warning. Developer tools let anyone at the keyboard read everything the app holds, mail and passwords in memory included.</string>
      <string id="RecentFilesInAttach">Show recent files in the Attach menu</string>
      <string id="RecentFilesInAttach_Explain">When enabled or not configured, the Attach button in a new message lists the files the user opened recently, as the operating system records them, so one click attaches one. The list is read when the menu opens and stays on the device. When disabled, the list is gone and the app refuses to read it. Attaching through the file dialog is not affected.</string>
      <string id="FilesDriveEnabled">Allow Files as a drive</string>
      <string id="FilesDriveEnabled_Explain">When enabled or not configured, people can show their Files in the file manager as a drive, with files downloaded when opened. Windows only for now. When disabled, the drive is not offered, and a drive that is already there is removed with the copies of files in it. Files on the server are not affected.</string>
      <string id="FilesFolderSyncEnabled">Allow syncing folders with Files</string>
      <string id="FilesFolderSyncEnabled_Explain">When enabled or not configured, people can keep a folder on the computer and a folder in Files the same, in both directions. When disabled, this is not offered and folders that sync now stop. The files in those folders stay where they are.</string>
      <string id="FilesDriveLetter">Drive letter for Files</string>
      <string id="FilesDriveLetter_Explain">Windows only. A letter from D to Z gives the Files drive that letter for every user, and they can&apos;t change it. Enter none to never give it a letter. When not configured, people choose under Settings, and there is no letter until they do. A value the app can&apos;t read counts as none.</string>
    </stringTable>
    <presentationTable>
      <presentation id="InstanceUrl"><textBox refId="InstanceUrl_Value"><label>Address of the Bulwark server</label></textBox></presentation>
      <presentation id="InstanceUrl_Recommended"><textBox refId="InstanceUrl_Recommended_Value"><label>Address of the Bulwark server</label></textBox></presentation>
      <presentation id="AllowedJmapServers"><listBox refId="AllowedJmapServers_Value">Allowed mail servers</listBox></presentation>
      <presentation id="UpdateChannel"><dropdownList refId="UpdateChannel_Value" noSort="true" defaultItem="0">Update channel</dropdownList></presentation>
      <presentation id="UpdateChannel_Recommended"><dropdownList refId="UpdateChannel_Recommended_Value" noSort="true" defaultItem="0">Update channel</dropdownList></presentation>
      <presentation id="PluginsMode"><dropdownList refId="PluginsMode_Value" noSort="true" defaultItem="0">Which plugins may run</dropdownList></presentation>
      <presentation id="PluginAllowlist"><listBox refId="PluginAllowlist_Value">Plugin ids</listBox></presentation>
      <presentation id="AppLockTimeoutMinutes"><decimalTextBox refId="AppLockTimeoutMinutes_Value" defaultValue="10">Minutes</decimalTextBox></presentation>
      <presentation id="AppLockTimeoutMinutes_Recommended"><decimalTextBox refId="AppLockTimeoutMinutes_Recommended_Value" defaultValue="10">Minutes</decimalTextBox></presentation>
      <presentation id="AppLockPinMinLength"><decimalTextBox refId="AppLockPinMinLength_Value" defaultValue="8">Characters</decimalTextBox></presentation>
      <presentation id="QuickComposeShortcut"><textBox refId="QuickComposeShortcut_Value"><label>Shortcut</label></textBox></presentation>
      <presentation id="QuickComposeShortcut_Recommended"><textBox refId="QuickComposeShortcut_Recommended_Value"><label>Shortcut</label></textBox></presentation>
      <presentation id="AuthServerAllowlist"><textBox refId="AuthServerAllowlist_Value"><label>Servers</label></textBox></presentation>
      <presentation id="AuthNegotiateDelegateAllowlist"><textBox refId="AuthNegotiateDelegateAllowlist_Value"><label>Servers</label></textBox></presentation>
      <presentation id="AutoSelectCertificateForUrls"><listBox refId="AutoSelectCertificateForUrls_Value">Rules</listBox></presentation>
      <presentation id="KeystoreAllowedOrigins"><listBox refId="KeystoreAllowedOrigins_Value">Addresses</listBox></presentation>
      <presentation id="WipeOfflineData"><textBox refId="WipeOfflineData_Value"><label>Wipe code</label></textBox></presentation>
      <presentation id="DeveloperToolsAvailability"><decimalTextBox refId="DeveloperToolsAvailability_Value" defaultValue="2">Value (0, 1 or 2)</decimalTextBox></presentation>
      <presentation id="FilesDriveLetter"><textBox refId="FilesDriveLetter_Value"><label>Drive letter</label></textBox></presentation>
    </presentationTable>
  </resources>
</policyDefinitionResources>
