<?xml version="1.0" encoding="utf-8"?>
<!-- Generated from lib/desktop/policy-schema.ts by scripts/generate-desktop-policies.mjs. Do not edit. -->
<policyDefinitionResources xmlns="http://schemas.microsoft.com/GroupPolicy/2006/07/PolicyDefinitions" revision="1.0" schemaVersion="1.0">
  <displayName>Bulwark Desktop</displayName>
  <description>Settings for the Bulwark desktop app.</description>
  <resources>
    <stringTable>
      <string id="Category_Bulwark">Bulwark</string>
      <string id="Category_Desktop">Bulwark Desktop</string>
      <string id="Category_Recommended">Bulwark Desktop: defaults users can change</string>
      <string id="SUPPORTED_Bulwark_Desktop">All versions of Bulwark Desktop</string>
      <string id="Category_connection">Connection</string>
      <string id="Category_updates">Updates</string>
      <string id="Category_plugins">Plugins</string>
      <string id="Category_security">Offline mail and app lock</string>
      <string id="Category_privacy">Privacy</string>
      <string id="Category_signIn">Sign-in and certificates</string>
      <string id="InstanceUrl">Bulwark server</string>
      <string id="InstanceUrl_Explain">The address of your Bulwark server, starting with https://. When forced, the app opens on this server, the choice of server is hidden, and the window stays on it. An invalid address shows an error page that names this policy, and the app does not fall back to anything else. As a default, the app opens on this server until the user picks something else.</string>
      <string id="AllowStandalone">Allow direct connections to mail servers</string>
      <string id="AllowStandalone_Explain">When disabled, the app only opens a Bulwark server and nobody can sign in directly to a mail server. Accounts added earlier stay on the disk, but are hidden. If you force a Bulwark server and leave this not configured, direct connections are off too. Enable it to offer both.</string>
      <string id="AllowedJmapServers">Allowed mail servers</string>
      <string id="AllowedJmapServers_Explain">The mail servers people may sign in to. One per line: an address such as https://mail.example.com, or https://*.example.com for all subdomains. A server without a scheme means https. Plain http must be named with http://. When this list is set, everything else is refused, and accounts on a server taken off the list stop until it is back, keeping their data. A Bulwark server the user picks, or the one under &quot;Bulwark server&quot; as a default, must be on the list too. A forced one does not need to be.</string>
      <string id="AllowInsecureInstance">Allow a Bulwark server on plain http</string>
      <string id="AllowInsecureInstance_Explain">When enabled, the address in &quot;Bulwark server&quot; may start with http://. Passwords and mail then travel unencrypted, and the browser features that need https, such as offline mail and S/MIME, do not work. Leave this off unless the server is on a network you trust.</string>
      <string id="UpdateChannel">Update channel</string>
      <string id="UpdateChannel_Explain">Which releases the app updates to.</string>
      <string id="UpdateChannel_stable">Stable</string>
      <string id="UpdateChannel_beta">Beta</string>
      <string id="AutoUpdate">Update automatically</string>
      <string id="AutoUpdate_Explain">When disabled, the app does not look for updates or download them. Use this when SCCM, Intune or similar tools deliver updates.</string>
      <string id="PluginsMode">Which plugins may run</string>
      <string id="PluginsMode_Explain">Whether plugins can be installed and run. With the list or none, people cannot add a plugin themselves, since a package can name any id. With the list, only plugins your Bulwark server or the app&apos;s directory provides can run. A plugin that is refused keeps its data and settings: it comes back as it was if the policy allows it again.</string>
      <string id="PluginsMode_allowed">All plugins are allowed</string>
      <string id="PluginsMode_allowlist">Only plugins on the list</string>
      <string id="PluginsMode_off">No plugins</string>
      <string id="PluginAllowlist">Allowed plugins</string>
      <string id="PluginAllowlist_Explain">The ids of the plugins that may run when &quot;Which plugins may run&quot; is set to the list. One per line.</string>
      <string id="OfflineEnabled">Keep mail on the device</string>
      <string id="OfflineEnabled_Explain">Whether accounts keep an encrypted copy of mail on this device for offline use. When forced off, copies already on the device are removed.</string>
      <string id="AppLockRequired">Require an app lock</string>
      <string id="AppLockRequired_Explain">When enabled, people must set up the app lock and cannot turn it off.</string>
      <string id="AppLockTimeoutMinutes">Lock the app after</string>
      <string id="AppLockTimeoutMinutes_Explain">How many minutes without use the app stays unlocked. From 1 to 1440.</string>
      <string id="TelemetryAllowed">Allow usage statistics</string>
      <string id="TelemetryAllowed_Explain">When disabled, the app sends no usage statistics and does not ask. When enabled or not configured, it still asks the user first.</string>
      <string id="CrashReportsAllowed">Allow crash reports</string>
      <string id="CrashReportsAllowed_Explain">When disabled, the app sends no crash reports and does not ask. When enabled or not configured, it still asks the user first.</string>
      <string id="QuickComposeShortcut">Global shortcut for a new message</string>
      <string id="QuickComposeShortcut_Explain">The key combination that opens a new message from anywhere, such as CommandOrControl+Alt+N. Enter off to turn the shortcut off.</string>
      <string id="AuthServerAllowlist">Servers for integrated sign-in</string>
      <string id="AuthServerAllowlist_Explain">The servers that may use the Windows sign-in (Kerberos, NTLM), separated by commas, such as *.example.com. Takes effect when the app restarts.</string>
      <string id="AuthNegotiateDelegateAllowlist">Servers for delegated sign-in</string>
      <string id="AuthNegotiateDelegateAllowlist_Explain">The servers the app may delegate Kerberos credentials to, separated by commas. Takes effect when the app restarts.</string>
      <string id="AutoSelectCertificateForUrls">Choose client certificates automatically</string>
      <string id="AutoSelectCertificateForUrls_Explain">One JSON rule per line, in the format Chrome uses: {&quot;pattern&quot;:&quot;https://[*.]example.com&quot;,&quot;filter&quot;:{&quot;ISSUER&quot;:{&quot;CN&quot;:&quot;Example CA&quot;}}}. The app then picks the matching certificate for that site without asking.</string>
      <string id="KeystoreAllowedOrigins">Sites that may use the system certificate store</string>
      <string id="KeystoreAllowedOrigins_Explain">The Bulwark servers, by https address, whose plugins may sign and decrypt with the certificates in the operating system&apos;s store, without the user being asked for each site. One per line.</string>
      <string id="WipeOfflineData">Delete mail kept on the device</string>
      <string id="WipeOfflineData_Explain">Set this to a new value, such as today&apos;s date, to delete everything the app keeps on the device for every server and account: mail, keys, and sign-ins, so people sign in again. Each value deletes once: the app remembers the ones it has acted on, so it stays safe to leave a value in place. Use a new value to delete again.</string>
    </stringTable>
    <presentationTable>
      <presentation id="InstanceUrl"><textBox refId="InstanceUrl_Value"><label>Address of the Bulwark server</label></textBox></presentation>
      <presentation id="InstanceUrl_Recommended"><textBox refId="InstanceUrl_Recommended_Value"><label>Address of the Bulwark server</label></textBox></presentation>
