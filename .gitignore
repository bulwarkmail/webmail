# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
# Source maps CI collects for the error tracker (scripts/sourcemaps.mjs)
/sourcemaps/
/lite-image/
# scripts/build-plugin-sandbox.mjs
/public/plugin-sandbox-assets/
# scripts/build-pst-worker.mjs
/public/pst-worker.js

# production
/build

# misc
.DS_Store
*.pem
# BIMI test certificates (public; the keys stay out)
!lib/__tests__/fixtures/bimi/*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example
!.env.dev.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# settings sync data
/data/

# Local private data
/local-data/

# Sibling repos
/repos/

# Kubernetes reference manifests: the secrets users fill in
deploy/kubernetes/base/secrets.env
