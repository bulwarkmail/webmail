# Sourced by /bin/sh inside the Lite container image: CRLF would break it.
*.envsh text eol=lf
# Run by sh from Git Bash on Windows, which does not strip CR.
.husky/* text eol=lf
# Demo fixtures record exact byte sizes of these files; never normalise them.
public/demo/** -text
# Checked against pinned hashes by scripts/fetch-sqlite3mc.mjs; never normalise them.
vendor/sqlite3mc/** -text
