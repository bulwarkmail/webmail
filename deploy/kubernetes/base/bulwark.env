# Settings for every Bulwark replica (no secrets here; those go in secrets.env).
# Any variable from https://bulwarkmail.org/docs/getting-started/configuration/environment-reference
# can be added.

# The JMAP server users sign in to. Both the pods and users' browsers must reach it.
JMAP_SERVER_URL=https://mail.example.com

# Proxies in front of the pods: 1 for an ingress controller alone, 2 if a cloud
# load balancer sits in front of it. Sign-in limits key on the address this picks.
TRUSTED_PROXY_DEPTH=1

SETTINGS_SYNC_ENABLED=true
LOG_LEVEL=info
