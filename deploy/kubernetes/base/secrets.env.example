# Copy to secrets.env (kept out of git) and fill in all three: the store
# doesn't start without VALKEY_PASSWORD, the webmail doesn't start without
# SESSION_SECRET, and without ADMIN_PASSWORD the admin console stays off.
# Generate each with:
#   openssl rand -hex 32
# (hex, so the store password needs no escaping inside REDIS_URL).
# Or delete the secretGenerator in kustomization.yaml and create the Secret
# `bulwark-secrets` with these three keys some other way (External Secrets,
# Sealed Secrets, your CI).

# Encrypts sessions, synced settings and plugin credentials. The same on every
# replica; changing it signs everyone out.
SESSION_SECRET=
# First admin password; hashed into the store on the first start.
ADMIN_PASSWORD=
# Password of the Valkey store.
VALKEY_PASSWORD=
