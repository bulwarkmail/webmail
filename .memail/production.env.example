# Copy these values into your deployment environment alongside the settings in
# the upstream .env.example. Replace the server, secret and source revision.
# Do not use .env.dev.example or DEV_MOCK_JMAP=true in production.
APP_NAME=Memail
APP_SHORT_NAME=Memail
APP_DESCRIPTION="A calmer place for email. Built on Bulwark and JMAP."
APP_LOGO_LIGHT_URL=/branding/memail/mark.svg
APP_LOGO_DARK_URL=/branding/memail/mark-dark.svg
LOGIN_LOGO_LIGHT_URL=/branding/memail/mark.svg
LOGIN_LOGO_DARK_URL=/branding/memail/mark-dark.svg
LOGIN_COMPANY_NAME="Memail by Saivra"
LOGIN_WEBSITE_URL=https://github.com/Saivra/memail-webmail
FAVICON_URL=/branding/memail/mark.svg
PWA_ICON_URL=/branding/memail/mark.svg
PWA_THEME_COLOR="#263b32"
PWA_BACKGROUND_COLOR="#ffffff"
JMAP_SERVER_URL=https://mail.example.com
SESSION_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
# Set this to the exact commit/tag that you deploy, not a moving branch.
SOURCE_CODE_URL=https://github.com/Saivra/memail-webmail/tree/REPLACE_WITH_DEPLOYED_COMMIT
